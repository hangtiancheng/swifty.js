{
  "name": "@swifty.js/docs",
  "version": "0.0.10",
  "description": "A beautiful documentation site generator powered by React",
  "keywords": [
    "@lark.js",
    "documentation",
    "docs",
    "hmr",
    "markdown",
    "mermaid"
  ],
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./compiler": {
      "import": {
        "types": "./dist/compiler.d.ts",
        "default": "./dist/compiler.js"
      },
      "require": {
        "types": "./dist/compiler.d.ts",
        "default": "./dist/compiler.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/theme/index.d.ts",
        "default": "./dist/theme.js"
      },
      "require": {
        "types": "./dist/theme/index.d.ts",
        "default": "./dist/theme.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts"
      },
      "require": {
        "types": "./dist/client.d.ts"
      }
    },
    "./client.css": "./dist/client.css"
  },
  "scripts": {
    "git:pull": "node ./pull.js",
    "build": "vite build --mode lib",
    "build:docs": "vite build --mode docs",
    "build:watch": "vite build --mode lib --watch",
    "dev": "vite --mode docs",
    "preview": "vite preview --mode docs",
    "format": "prettier -w ./ --experimental-cli",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pwa": "pnpm dlx @vite-pwa/assets-generator --preset minimal public/favicon.svg",
    "prepublishOnly": "pnpm build",
    "add:user": "npm adduser --registry=https://registry.npmjs.org/",
    "publish:latest": "npm publish --access public --registry=https://registry.npmjs.org/",
    "publish:alpha": "npm publish --access public --registry=https://registry.npmjs.org/ --tag alpha",
    "publish:beta": "npm publish --access public --registry=https://registry.npmjs.org/ --tag beta",
    "publish:rc": "npm publish --access public --registry=https://registry.npmjs.org/ --tag rc",
    "publish:canary": "npm publish --access public --registry=https://registry.npmjs.org/ --tag canary",
    "publish:nightly": "npm publish --access public --registry=https://registry.npmjs.org/ --tag nightly",
    "publish:dev": "npm publish --access public --registry=https://registry.npmjs.org/ --tag dev"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^4.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "ejs": "^3.1.10",
    "js-yaml": "^5.2.0",
    "lucide-react": "^1.31.0",
    "markdown-it": "^14.2.0",
    "markdown-it-container": "^4.0.0",
    "mermaid": "^11.16.0",
    "minisearch": "^7.2.0",
    "shiki": "^4.3.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/ejs": "^3.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "4.1.9",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "lint-staged": {
    "*.{json,jsonc,js,cjs,mjs,ts,cts,mts,html,css,md}": [
      "pnpm format"
    ]
  },
  "packageManager": "pnpm@10.33.1"
}

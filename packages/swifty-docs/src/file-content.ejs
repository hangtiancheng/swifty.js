// Auto-generated by defineConfig() — DO NOT EDIT!!!

const loaders = {
<%- loaderEntries %>
};

// route path -> fresh module pushed by HMR (dev only; always empty in prod)
const _freshModules = Object.create(null);

/**
 * Load a docs page's content module by route path.
 * Returns null for unknown paths so the layout can render a not-found state.
 */
export async function loadContent(path) {
  // Normalize path: strip trailing slashes and /index, /index.md, /index.html
  // suffixes so "/docs/ch1/index.md" resolves the same as "/docs/ch1".
  let normalized = (path || "/").replace(/\/+$/, "") || "/";
  normalized = normalized.replace(/^(.*?)(?:\/index(?:\.md|\.html)?)\/?$/, (_m, p1) => p1 || "/");
  const fresh = _freshModules[normalized];
  if (fresh) return { pageData: fresh.pageData, contentHtml: fresh.contentHtml };
  const loader = loaders[normalized];
  if (!loader) return null;
  const mod = await loader();
  return { pageData: mod.pageData, contentHtml: mod.contentHtml };
}

export const docsConfig = <%- docsConfigJson %>;

// Canonical content paths — excludes trailing-slash aliases and virtual
// index routes so the search index has no duplicate entries.
const _searchablePaths = new Set(<%- searchablePathsJson %>);

// Search index — lazily built on first search by loading all .md modules
// and extracting pageData. This avoids serializing a large searchIndex
// (every page's title + all headings + excerpt) into this generated file.
let _searchIndex = null;
export async function getSearchIndex() {
  if (_searchIndex) return _searchIndex;
  const entries = Object.entries(loaders).filter(([k]) =>
    _searchablePaths.has(k),
  );
  const mods = await Promise.all(
    entries.map(([k, loader]) => _freshModules[k] || loader()),
  );
  _searchIndex = mods.map((mod, i) => {
    const link = entries[i][0];
    const pd = mod.pageData || {};
    return {
      title: pd.title || "",
      link,
      headings: (pd.headings || []).map((h) => h.text || ""),
      excerpt: pd.excerpt || pd.description || "",
    };
  });
  return _searchIndex;
}

// Dev-only markdown hot reload. This module is the HMR accept boundary for
// every .md page: on edit, Vite re-fetches the compiled md module (through
// the full plugin pipeline, so docs-guard encryption still applies) and the
// callback caches it and notifies subscribers with the affected route paths.
const _updateSubscribers = new Set();

/** Subscribe to md hot updates. Returns an unsubscribe function. */
export function onContentUpdate(cb) {
  _updateSubscribers.add(cb);
  return () => _updateSubscribers.delete(cb);
}

if (import.meta.hot) {
  const hotRoutes = <%- hotRoutesJson %>;
  import.meta.hot.accept(<%- hotDepsJson %>, (mods) => {
    const changed = [];
    mods.forEach((mod, i) => {
      if (!mod) return;
      for (const route of hotRoutes[i]) {
        _freshModules[route] = mod;
        changed.push(route);
      }
    });
    if (!changed.length) return;
    _searchIndex = null;
    for (const cb of _updateSubscribers) cb(changed);
  });
}

{
  "name": "@swifty.js/react",
  "version": "0.0.1",
  "description": "react, previously @swifty.js/preact",
  "keywords": [
    "all-in-one",
    "fork",
    "framework",
    "jsx",
    "light-weight",
    "react",
    "virtual-dom"
  ],
  "homepage": "https://github.com/hangtiancheng/swifty.js/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/hangtiancheng/swifty.js/issues"
  },
  "license": "MIT",
  "author": "hangtiancheng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hangtiancheng/swifty.js.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/react.mjs",
  "module": "dist/react.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/react.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:lib": "vite build --mode lib && tsc -p tsconfig.lib.json && node scripts/fix-dts.mjs",
    "dev": "vite",
    "format": "prettier -w .",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build:lib"
  },
  "dependencies": {
    "@swifty.js/anti-copy": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}

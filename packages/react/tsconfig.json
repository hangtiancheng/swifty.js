{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@swifty.js/react",
    "types": [],
    "paths": {
      "@swifty.js/react/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"],
      "@swifty.js/react/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@swifty.js/react/vite": ["./src/vite.ts"],
      "@swifty.js/react/webpack": ["./src/webpack.ts"],
      "@swifty.js/react": ["./src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests", "tsup.config.ts", "vitest.config.ts"]
}

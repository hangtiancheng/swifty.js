	"dependencies": {
		"dotenv": "^17.4.2",
		"js-yaml": "^5.3.0",
		"openai": "^7.5.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"tsup": "^8.5.1",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}

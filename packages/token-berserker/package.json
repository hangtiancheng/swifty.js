{
	"name": "token-berserker",
	"version": "0.0.0",
	"private": true,
	"description": "token-berserker",
	"main": "dist/index.js",
	"scripts": {
		"check": "biome check ./src ./tests --write",
		"typecheck": "tsc --noEmit",

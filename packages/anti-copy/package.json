{
  "name": "@swifty.js/anti-copy",
  "version": "0.0.3",
  "description": "Copy-protection SDK for browsers",
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "repository": {
    "type": "git",
    "url": "https://github.com/hangtiancheng/swifty.js.git",
    "directory": "packages/anti-copy"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vitepress": {
      "types": "./dist/vitepress.d.ts",
      "import": "./dist/vitepress.js",
      "require": "./dist/vitepress.cjs"
    },
    "./swifty-docs": {
      "types": "./dist/swifty-docs.d.ts",
      "import": "./dist/swifty-docs.js",
      "require": "./dist/swifty-docs.cjs"
    },
    "./lark-docs": {
      "types": "./dist/lark-docs.d.ts",
      "import": "./dist/lark-docs.js",
      "require": "./dist/lark-docs.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c ./rollup.config.js",
    "test": "vitest run",
    "format": "oxfmt --write ./",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@lark.js/mvc": "^0.0.26",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swifty.js/docs": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.5",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "@lark.js/mvc": ">=0.0.26",
    "@swifty.js/docs": ">=0.0.11",
    "react": "^18.0.0 || ^19.0.0",
    "vitepress": ">=1.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@lark.js/mvc": {
      "optional": true
    },
    "@swifty.js/docs": {
      "optional": true
    },
    "vitepress": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
